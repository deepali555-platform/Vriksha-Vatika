{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered terrace gardener user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth user ID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User avatar profile photo URL" },
        "createdAt": { "type": "string", "description": "Profile creation timestamp" },
        "lastLoginAt": { "type": "string", "description": "Last login timestamp" }
      },
      "required": ["uid"]
    },
    "UserPlantState": {
      "title": "UserPlantState",
      "description": "User specific garden state, fertilizer schedule, and private scans for a plant",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Plant identifier" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "inMyGarden": { "type": "boolean", "description": "Whether the user owns this plant" },
        "isFavorite": { "type": "boolean", "description": "Whether the plant is favorited" },
        "lastFertilizedDate": { "type": "string", "description": "ISO date string of last feeding" },
        "customPhotoUrl": { "type": "string", "description": "User custom plant photograph" },
        "customFertilizerIntervalDays": { "type": "number", "description": "Custom feeding interval in days" },
        "updatedAt": { "type": "string", "description": "Last updated ISO timestamp" }
      },
      "required": ["id", "userId", "inMyGarden"]
    },
    "CustomPlant": {
      "title": "CustomPlant",
      "description": "Privately created plant species added by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique custom plant ID" },
        "userId": { "type": "string", "description": "Author user ID" },
        "name": { "type": "string", "description": "Plant name" },
        "category": { "type": "string", "description": "Plant category" },
        "inMyGarden": { "type": "boolean", "description": "Owned in garden" },
        "createdAt": { "type": "string", "description": "Created ISO timestamp" },
        "updatedAt": { "type": "string", "description": "Updated ISO timestamp" }
      },
      "required": ["id", "userId", "name", "category"]
    },
    "UserSubmittedPlant": {
      "title": "UserSubmittedPlant",
      "description": "Plant submitted by a user for review into the shared catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Submission ID" },
        "originalPlantId": { "type": "string", "description": "Original custom plant ID" },
        "userId": { "type": "string", "description": "Submitting user ID" },
        "userEmail": { "type": "string", "description": "Submitting user email" },
        "userDisplayName": { "type": "string", "description": "Submitting user display name" },
        "plantName": { "type": "string", "description": "Plant common name" },
        "botanicalName": { "type": "string", "description": "Botanical name" },
        "category": { "type": "string", "description": "Plant category" },
        "status": { "type": "string", "enum": ["pending", "approved", "dismissed"], "description": "Review status" },
        "submittedAt": { "type": "string", "description": "Submission ISO date" },
        "reviewedAt": { "type": "string", "description": "Review ISO date" }
      },
      "required": ["id", "userId", "plantName", "category", "status", "submittedAt"]
    },
    "SharedCatalogPlant": {
      "title": "SharedCatalogPlant",
      "description": "Community plant in the shared reference catalog, visible to all users and guests immediately",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Shared plant ID" },
        "name": { "type": "string", "description": "Common plant name" },
        "category": { "type": "string", "description": "Plant category" },
        "addedByUserId": { "type": "string", "description": "Original creator user ID" },
        "addedByUserEmail": { "type": "string", "description": "Original creator email" },
        "addedByUserName": { "type": "string", "description": "Original creator display name" },
        "createdAt": { "type": "string", "description": "Creation ISO timestamp" },
        "updatedAt": { "type": "string", "description": "Update ISO timestamp" },
        "isSharedCatalog": { "type": "boolean", "description": "True for shared catalog plants" }
      },
      "required": ["id", "name", "category", "isSharedCatalog"]
    },
    "SystemBackup": {
      "title": "SystemBackup",
      "description": "Audit log record of database backup, restore, or reset operations restricted to app administrators",
      "type": "object",
      "properties": {
        "backupId": { "type": "string", "description": "Unique record identifier" },
        "action": { "type": "string", "description": "Action performed: export, restore, or reset_to_defaults" },
        "timestamp": { "type": "string", "description": "ISO timestamp of operation" },
        "adminEmail": { "type": "string", "description": "Email of admin who triggered action" },
        "itemCount": { "type": "number", "description": "Number of items affected" }
      },
      "required": ["backupId", "action", "timestamp", "adminEmail"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private profile document for each authenticated user"
    },
    "/users/{userId}/userPlants/{plantId}": {
      "schema": "UserPlantState",
      "description": "Private plant ownership, fertilizer dates, and scan history per user"
    },
    "/users/{userId}/customPlants/{plantId}": {
      "schema": "CustomPlant",
      "description": "Custom plants created by the user via Add Plant form"
    },
    "/userSubmittedPlants/{submissionId}": {
      "schema": "UserSubmittedPlant",
      "description": "Log of all custom plants submitted by users for admin moderation"
    },
    "/sharedPlants/{plantId}": {
      "schema": "SharedCatalogPlant",
      "description": "Global community plants approved into the shared reference catalog"
    },
    "/systemBackups/{backupId}": {
      "schema": "SystemBackup",
      "description": "Audit records for database export, restore, and reset actions restricted to administrators"
    }
  }
}
